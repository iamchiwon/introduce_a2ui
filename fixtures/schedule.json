{
  "name": "일정 예약",
  "description": "일반 스케줄 등록",
  "messages": [
    {
      "version": "1.0",
      "createSurface": {
        "surfaceId": "schedule",
        "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
        "sendDataModel": true,
        "components": [
          {
            "id": "root",
            "component": "Card",
            "child": "col"
          },
          {
            "id": "col",
            "component": "Column",
            "align": "stretch",
            "children": [
              "title",
              "name",
              "allDay",
              "times",
              "repeat",
              "alarm",
              "memo",
              "summary",
              "submit"
            ]
          },
          {
            "id": "title",
            "component": "Text",
            "text": "## 새 일정"
          },
          {
            "id": "name",
            "component": "TextField",
            "label": "제목",
            "value": {
              "@path": "/title"
            },
            "placeholder": "예: 팀 회의",
            "@checks": [
              {
                "condition": {
                  "@call": "required",
                  "args": {
                    "value": {
                      "@path": "/title"
                    }
                  }
                },
                "message": "제목을 입력하세요."
              }
            ]
          },
          {
            "id": "allDay",
            "component": "CheckBox",
            "label": "종일",
            "value": {
              "@path": "/allDay"
            }
          },
          {
            "id": "times",
            "component": "Row",
            "children": [
              "start",
              "end"
            ]
          },
          {
            "id": "start",
            "component": "DateTimeInput",
            "label": "시작",
            "value": {
              "@path": "/start"
            },
            "enableDate": true,
            "enableTime": true,
            "weight": 1
          },
          {
            "id": "end",
            "component": "DateTimeInput",
            "label": "종료",
            "value": {
              "@path": "/end"
            },
            "enableDate": true,
            "enableTime": true,
            "weight": 1
          },
          {
            "id": "repeat",
            "component": "ChoicePicker",
            "label": "반복",
            "options": [
              {
                "value": "none",
                "label": "안 함"
              },
              {
                "value": "daily",
                "label": "매일"
              },
              {
                "value": "weekly",
                "label": "매주"
              },
              {
                "value": "monthly",
                "label": "매월"
              }
            ],
            "value": {
              "@path": "/repeat"
            },
            "displayStyle": "chips"
          },
          {
            "id": "alarm",
            "component": "ChoicePicker",
            "label": "알림",
            "variant": "multipleSelection",
            "options": [
              {
                "value": "0",
                "label": "정시"
              },
              {
                "value": "10",
                "label": "10분 전"
              },
              {
                "value": "30",
                "label": "30분 전"
              },
              {
                "value": "1440",
                "label": "하루 전"
              }
            ],
            "value": {
              "@path": "/alarms"
            }
          },
          {
            "id": "memo",
            "component": "TextField",
            "label": "메모",
            "value": {
              "@path": "/memo"
            },
            "variant": "longText"
          },
          {
            "id": "summary",
            "component": "Text",
            "text": {
              "@call": "formatString",
              "args": {
                "value": "${/title} · ${/start} ~ ${/end}"
              }
            },
            "variant": "caption"
          },
          {
            "id": "submit",
            "component": "Button",
            "child": "submit_label",
            "variant": "primary",
            "action": {
              "event": {
                "name": "schedule_submit",
                "context": {
                  "title": {
                    "@path": "/title"
                  },
                  "start": {
                    "@path": "/start"
                  },
                  "end": {
                    "@path": "/end"
                  },
                  "allDay": {
                    "@path": "/allDay"
                  },
                  "repeat": {
                    "@path": "/repeat"
                  },
                  "alarms": {
                    "@path": "/alarms"
                  },
                  "memo": {
                    "@path": "/memo"
                  }
                }
              }
            },
            "@checks": [
              {
                "condition": {
                  "@call": "required",
                  "args": {
                    "value": {
                      "@path": "/title"
                    }
                  }
                },
                "message": "제목을 입력하세요."
              },
              {
                "condition": {
                  "@call": "required",
                  "args": {
                    "value": {
                      "@path": "/start"
                    }
                  }
                },
                "message": "시작 시간을 선택하세요."
              }
            ]
          },
          {
            "id": "submit_label",
            "component": "Text",
            "text": "일정 저장"
          }
        ],
        "dataModel": {
          "title": "",
          "allDay": false,
          "start": "2026-12-01T10:00",
          "end": "2026-12-01T11:00",
          "repeat": [
            "none"
          ],
          "alarms": [
            "10"
          ],
          "memo": ""
        }
      }
    }
  ]
}
